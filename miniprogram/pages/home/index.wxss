.bell { position: relative; width: 76rpx; height: 76rpx; border-radius: 999rpx; background: #FFFFFF; display: flex; align-items: center; justify-content: center; box-shadow: 0 2rpx 12rpx rgba(60, 40, 30, 0.08); }
.bell-icon { position: relative; width: 32rpx; height: 34rpx; }
.bell-body { position: absolute; left: 2rpx; top: 0; width: 28rpx; height: 26rpx; border: 4rpx solid #2B2522; border-bottom: none; border-radius: 16rpx 16rpx 4rpx 4rpx; box-sizing: border-box; }
.bell-clapper { position: absolute; left: 0; right: 0; bottom: 4rpx; height: 4rpx; background: #2B2522; border-radius: 4rpx; }
.bell-clapper::after { content: ""; position: absolute; left: 11rpx; top: 6rpx; width: 10rpx; height: 6rpx; background: #2B2522; border-radius: 0 0 8rpx 8rpx; }
.bell-badge { position: absolute; top: -6rpx; right: -10rpx; }
.hero { padding: 32rpx 8rpx 16rpx; text-align: center; }
.hero-label { font-size: 28rpx; color: #5A4A40; }
.hero-value { font-weight: 700; letter-spacing: -3rpx; line-height: 1.05; color: #1D1D1F; margin-top: 8rpx; font-variant-numeric: tabular-nums; max-width: 100%; overflow: hidden; word-break: break-all; }
.hero-quick { display: flex; justify-content: center; width: 100%; margin-top: 24rpx; }
.hero-q { flex: 1; min-width: 0; margin-right: 0; text-align: center; padding: 0 8rpx; }
.hero-q-v { font-size: 28rpx; font-weight: 600; margin-top: 6rpx; font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.stats { display: flex; background: #FFFFFF; border-radius: 32rpx; padding: 28rpx 8rpx; margin-top: 28rpx; box-shadow: 0 2rpx 16rpx rgba(60, 40, 30, 0.05); }
.stat { flex: 1; text-align: center; border-right: 1rpx solid #F1EAE4; }
.stat:last-child { border-right: none; }
.stat-v { font-size: 32rpx; font-weight: 600; margin-top: 8rpx; color: #1D1D1F; }
.summary { margin: 28rpx 0 8rpx; }
.summary-v { font-size: 48rpx; font-weight: 700; color: #1D1D1F; margin: 6rpx 0; }
.summary-open { display: inline-block; margin-top: 12rpx; color: #B4532F; font-size: 26rpx; }
.trend-canvas { width: 100%; height: 460rpx; margin-top: 12rpx; }
.trend-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.pager { font-size: 26rpx; color: #B4532F; padding: 8rpx 4rpx; }
.pager.off { color: #D8CDC5; }
.product-canvas { width: 100%; }
.rank-no { width: 48rpx; font-size: 26rpx; font-weight: 700; color: #D97757; }
.rank-v { font-size: 30rpx; font-weight: 600; margin-left: 16rpx; }
