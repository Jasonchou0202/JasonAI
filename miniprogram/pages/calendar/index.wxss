.cal { padding: 24rpx 20rpx; }
.cal-head { padding: 0 12rpx 16rpx; }
.cal-nav { font-size: 40rpx; color: #B4532F; padding: 0 20rpx; }
.cal-week { display: flex; }
.cal-wd { flex: 1; text-align: center; font-size: 22rpx; color: #A4958A; padding: 8rpx 0; }
.cal-day { flex: 1; height: 84rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 20rpx; }
.cal-day.out .cal-num { color: #D2C6BD; }
.cal-num { font-size: 28rpx; color: #1D1D1F; width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center; border-radius: 999rpx; }
.cal-day.today .cal-num { color: #D97757; font-weight: 700; }
.cal-day.sel .cal-num { background: #D97757; color: #FFFFFF; font-weight: 600; }
.cal-dots { display: flex; height: 10rpx; margin-top: 2rpx; }
.dot { width: 8rpx; height: 8rpx; border-radius: 999rpx; margin: 0 2rpx; }
.dot.open { background: #D97757; }
.dot.done { background: #C9BDB3; }
.views { margin-top: 28rpx; }
.task { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #F1EAE4; }
.task:last-child { border-bottom: none; }
.task-time { width: 112rpx; font-size: 26rpx; color: #5A4A40; font-weight: 600; }
.task-title { font-size: 30rpx; color: #1D1D1F; }
.task-title.done { color: #A4958A; text-decoration: line-through; }
.tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 999rpx; margin-left: 12rpx; white-space: nowrap; }
.tag.todo { background: #FBE9E2; color: #B4532F; }
.tag.late { background: #F6DEDA; color: #9E2A1E; }
.tag.done { background: #EFEAE5; color: #8A7B70; }
.tag.gone { background: #EFEAE5; color: #A4958A; }
.group-title { margin-bottom: 8rpx; }
.count { margin-left: 12rpx; font-weight: 400; }
