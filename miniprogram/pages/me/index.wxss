.avatar { width: 96rpx; height: 96rpx; border-radius: 999rpx; background: #FBE9E2; color: #B4532F; font-size: 40rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; flex-shrink: 0; }
.profile-btn { width: auto; margin-left: 0; margin-right: 0; padding-left: 32rpx; padding-right: 32rpx; background: #FFFFFF; text-align: left; line-height: inherit; font: inherit; color: inherit; border: none; box-sizing: border-box; }
.profile-btn::after { border: none; }
.avatar-img { width: 96rpx; height: 96rpx; border-radius: 999rpx; display: block; background: #FBE9E2; margin-right: 24rpx; flex-shrink: 0; }
.hint { margin-top: 6rpx; }
.menu { padding-top: 8rpx; padding-bottom: 8rpx; }
.arrow { margin-left: 12rpx; }
.tip { margin: 28rpx 8rpx 0; }
.leave { color: #9E2A1E; margin-top: 60rpx; }
.avatar-canvas { width: 128px; height: 128px; position: fixed; left: -9999px; top: 0; }
