/* 第 3 批页面样式：奶油底 + 珊瑚橙 #D97757，苹果官网式的大标题、留白和分组列表 */
.page { padding: 24rpx 32rpx 80rpx; min-height: 100vh; box-sizing: border-box; }
.hero { padding: 24rpx 8rpx 8rpx; }
.hero-title { font-size: 56rpx; font-weight: 700; letter-spacing: -1rpx; color: #1F1A17; }
.hero-sub { font-size: 28rpx; color: #7A6A5F; margin-top: 10rpx; line-height: 1.55; }
.pill { display: inline-flex; align-items: center; font-size: 22rpx; color: #9A5A3F; background: #F6E6DD; border-radius: 999rpx; padding: 6rpx 18rpx; margin-top: 16rpx; }
.pill.gray { color: #7A6A5F; background: #EFE9E4; }
.pill.green { color: #2F6B45; background: #E3F1E7; }
.pill.red { color: #9E2A1E; background: #F8E1DD; }
.section-title { font-size: 24rpx; color: #8C7B70; margin: 44rpx 16rpx 14rpx; letter-spacing: 1rpx; }
.group { background: #FFFFFF; border-radius: 28rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(60, 40, 30, 0.04); }
.row { display: flex; align-items: center; padding: 30rpx 32rpx; position: relative; }
.row + .row::before { content: ""; position: absolute; left: 112rpx; right: 0; top: 0; border-top: 1rpx solid #EFE9E4; }
.row.plain + .row.plain::before { left: 32rpx; }
.row-hover { background: #F7F1EC; }
.icon { width: 56rpx; height: 56rpx; border-radius: 16rpx; background: #D97757; color: #fff; font-size: 28rpx; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; flex-shrink: 0; }
.icon.soft { background: #F6E6DD; color: #B4532F; }
.row-main { flex: 1; min-width: 0; }
.row-title { font-size: 30rpx; color: #1F1A17; }
.row-desc { font-size: 24rpx; color: #8C7B70; margin-top: 6rpx; line-height: 1.5; }
.row-value { font-size: 28rpx; color: #7A6A5F; margin-left: 16rpx; }
.chev { color: #C9BBB1; font-size: 34rpx; margin-left: 12rpx; }
.panel { background: #FFFFFF; border-radius: 28rpx; padding: 36rpx 32rpx; margin-top: 24rpx; box-shadow: 0 2rpx 12rpx rgba(60, 40, 30, 0.04); }
.panel-title { font-size: 32rpx; font-weight: 600; color: #1F1A17; }
.panel-desc { font-size: 26rpx; color: #7A6A5F; margin-top: 10rpx; line-height: 1.6; }
.stats { display: flex; flex-wrap: wrap; margin: 20rpx -10rpx 0; }
.stat { width: 50%; padding: 10rpx; box-sizing: border-box; }
.stat-in { background: #FAF7F4; border-radius: 20rpx; padding: 22rpx 24rpx; }
.stat-label { font-size: 22rpx; color: #8C7B70; }
.stat-value { font-size: 40rpx; font-weight: 650; color: #1F1A17; margin-top: 6rpx; letter-spacing: -0.5rpx; }
.stat-value.coral { color: #C2603E; }
.stat-note { font-size: 20rpx; color: #A39388; margin-top: 6rpx; line-height: 1.4; }
.primary { background: #D97757 !important; color: #fff !important; border-radius: 999rpx !important; font-size: 30rpx !important; font-weight: 600 !important; padding: 22rpx 0 !important; margin-top: 32rpx !important; width: 100% !important; }
.primary[disabled] { background: #E8C4B6 !important; color: #fff !important; }
.ghost { background: #F6E6DD !important; color: #B4532F !important; border-radius: 999rpx !important; font-size: 30rpx !important; padding: 22rpx 0 !important; margin-top: 20rpx !important; width: 100% !important; }
.danger-text { color: #9E2A1E; }
.note { font-size: 24rpx; color: #8C7B70; line-height: 1.6; margin-top: 18rpx; }
.err { color: #9E2A1E; font-size: 26rpx; margin-top: 18rpx; line-height: 1.5; }
.ok { color: #2F6B45; font-size: 26rpx; margin-top: 18rpx; }
.progress { height: 12rpx; background: #F1E9E3; border-radius: 999rpx; margin-top: 24rpx; overflow: hidden; }
.progress-bar { height: 100%; background: #D97757; border-radius: 999rpx; }
.list-line { font-size: 24rpx; color: #7A6A5F; line-height: 1.7; }
.demo-bar { background: #1F1A17; color: #FAF7F4; border-radius: 22rpx; padding: 20rpx 28rpx; font-size: 24rpx; margin-bottom: 8rpx; display: flex; justify-content: space-between; align-items: center; }
.demo-bar .exit { color: #F2B79F; }
.field { margin-top: 26rpx; }
.field-label { font-size: 24rpx; color: #8C7B70; margin-bottom: 10rpx; }
.input { border: 1rpx solid #E8DFD8; border-radius: 18rpx; padding: 20rpx 24rpx; background: #FFFDFB; font-size: 30rpx; min-height: 44rpx; }
.grid2 { display: flex; flex-wrap: wrap; margin: 0 -10rpx; }
.grid2 .field { width: 50%; padding: 0 10rpx; box-sizing: border-box; }
.seg { display: flex; background: #F1E9E3; border-radius: 999rpx; padding: 6rpx; margin-top: 20rpx; }
.seg-item { flex: 1; text-align: center; font-size: 26rpx; padding: 14rpx 0; border-radius: 999rpx; color: #7A6A5F; }
.seg-item.on { background: #fff; color: #1F1A17; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(60, 40, 30, 0.08); }
.avatar-big { width: 200rpx; height: 200rpx; border-radius: 50%; background: #F6E6DD; display: flex; align-items: center; justify-content: center; font-size: 72rpx; color: #B4532F; margin: 12rpx auto 0; overflow: hidden; }
.avatar-big image { width: 100%; height: 100%; }
.tag { display: inline-block; font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 999rpx; margin: 6rpx 8rpx 0 0; background: #EFE9E4; color: #7A6A5F; }
.tag.done { background: #E3F1E7; color: #2F6B45; }
.tag.wait { background: #F6E6DD; color: #9A5A3F; }
.risk { display: flex; padding: 16rpx 0; font-size: 24rpx; line-height: 1.55; color: #3A302A; }
.risk + .risk { border-top: 1rpx solid #F1E9E3; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin: 12rpx 16rpx 0 0; flex-shrink: 0; background: #C9BBB1; }
.dot.red { background: #C2412D; }
.dot.yellow { background: #E0A43B; }
.stage-bar { display: flex; align-items: center; margin-top: 16rpx; font-size: 24rpx; color: #3A302A; }
.stage-name { width: 120rpx; }
.stage-track { flex: 1; height: 16rpx; background: #F6EFEA; border-radius: 999rpx; margin: 0 16rpx; overflow: hidden; }
.stage-fill { height: 100%; background: #D97757; border-radius: 999rpx; }
.stage-count { width: 40rpx; text-align: right; color: #7A6A5F; }
.stats.on-page .stat-in { background: #FFFFFF; box-shadow: 0 2rpx 12rpx rgba(60, 40, 30, 0.04); }
