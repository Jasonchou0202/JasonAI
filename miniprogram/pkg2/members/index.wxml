<privacy-popup />
<view class="pg">
  <view class="eyebrow">团队账号</view>
  <view class="h1">成员管理</view>
  <view class="lead">成员只能看数据、记一笔、加客户、建日程，不能改系统。</view>
  <view class="loading" wx:if="{{loading}}">正在读取…</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <block wx:if="{{v}}">
    <view class="sec">
      <view class="h2">邀请网页成员</view>
      <view class="card">
        <view class="add-row">
          <input class="input grow" placeholder="备注名，如：小王" maxlength="20" value="{{name}}" bindinput="onName" />
          <view class="mini dark" bindtap="invite">生成邀请</view>
        </view>
        <view class="invite" wx:if="{{created}}">
          <view class="title-line">给「{{created.name}}」的邀请链接</view>
          <view class="sub-line">只显示这一次，{{created.until}} 前有效。对方用 GitHub 登录网页后打开链接，你再点「批准」。</view>
          <view class="code">{{created.link}}</view>
          <view class="mini dark" bindtap="copy">复制链接</view>
        </view>
        <view class="note">小程序成员不用邀请码：对方在小程序里填姓名和手机号申请，你在「我的 → 成员申请」批准。</view>
      </view>
    </view>
    <view class="sec">
      <view class="row"><view class="h2">成员</view><view class="mini plain" wx:if="{{v.needFill}}" bindtap="fill">给已有成员补色</view></view>
      <view class="card">
        <view class="list-item" wx:if="{{colors}}">
          <view class="row"><view><text class="dot" style="background:{{v.owner.color}}"></text><text class="title-line">{{v.owner.name}}</text> <text class="pill coral tag">管理员</text></view></view>
          <view class="sub-line">{{v.owner.colorName}}</view>
        </view>
        <view class="empty" wx:if="{{!v.rows.length}}">还没有成员。</view>
        <view class="list-item" wx:for="{{v.rows}}" wx:key="uid">
          <view class="row">
            <view><text class="dot" wx:if="{{colors && item.color}}" style="background:{{item.color}}"></text><text class="title-line">{{item.name}}</text> <text class="pill tag" wx:if="{{item.miniapp}}">小程序</text></view>
            <text class="ms ms-{{item.status}}">{{item.statusText}}</text>
          </view>
          <view class="sub-line">加入 {{item.joined}}{{colors ? ' · ' + item.colorName : ''}}</view>
          <view class="sub-line" wx:if="{{colors && item.sameColor}}">{{item.sameColor}}</view>
          <view class="actions">
            <view class="mini dark" wx:if="{{item.status === 'pending'}}" data-uid="{{item.uid}}" data-a="approve" bindtap="act">批准</view>
            <view class="mini danger" wx:if="{{item.status !== 'disabled'}}" data-uid="{{item.uid}}" data-a="disable" bindtap="act">停用</view>
            <view class="mini" wx:if="{{item.status === 'disabled'}}" data-uid="{{item.uid}}" data-a="enable" bindtap="act">恢复</view>
          </view>
        </view>
      </view>
    </view>
    <view class="sec" wx:if="{{invites.length}}">
      <view class="h2">未使用的邀请</view>
      <view class="card">
        <view class="list-item row" wx:for="{{invites}}" wx:key="id">
          <view><view>{{item.name}}</view><view class="sub-line">{{item.until}} 前有效</view></view>
          <view class="mini danger" data-id="{{item.id}}" bindtap="revoke">撤销</view>
        </view>
      </view>
    </view>
  </block>
</view>
