@import "../common.wxss";
.add-row { display: flex; align-items: center; }
.grow { flex: 1; margin-right: 16rpx; }
.invite { margin-top: 24rpx; background: #FAECE7; border-radius: 20rpx; padding: 22rpx; }
.code { font-family: Menlo, monospace; font-size: 22rpx; word-break: break-all; background: #fff; border-radius: 12rpx; padding: 14rpx; margin: 14rpx 0; }
.ms { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx; }
.ms-active { background: #F4E6D4; color: #4F4038; }
.ms-pending { background: #F9ECD6; color: #7A5320; }
.ms-disabled { background: #F8DAD4; color: #9E2A1E; }
