@import "../common.wxss";
.stats { display: flex; margin: 24rpx -8rpx 0; }
.stat { flex: 1; margin: 0 8rpx; background: #fff; border-radius: 24rpx; padding: 22rpx 20rpx; }
.stat .k { font-size: 22rpx; color: #6B5A50; }
.stat .v { font-size: 34rpx; font-weight: 700; margin-top: 6rpx; font-variant-numeric: tabular-nums; }
.stat .s { font-size: 21rpx; color: #6B5A50; margin-top: 4rpx; }
.stat-pending .v { color: #9E2A1E; }
.stat-issued .v { color: #1B6B40; }
.stat-warn .v { color: #9E2A1E; }
.center { justify-content: center; }
.filter-scroll { white-space: nowrap; margin-top: 8rpx; }
.filters { display: inline-flex; padding: 4rpx 0 12rpx; }
.fchip { display: inline-block; font-size: 25rpx; padding: 12rpx 26rpx; border-radius: 999rpx; background: #fff; box-shadow: inset 0 0 0 1rpx #F0DCC8; margin-right: 12rpx; color: #4F4038; }
.fchip.on { background: #2B211C; color: #fff; }
.picker-line { margin-top: 8rpx; }
.schip { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 999rpx; font-weight: 600; }
.ink { color: #2B211C; }
.prof { font-size: 23rpx; padding: 4rpx 14rpx; border-radius: 10rpx; line-height: 48rpx; }
.prof.ok { background: #F4E6D4; color: #4F4038; }
.prof.miss { background: #F8DAD4; color: #9E2A1E; }
.grow { flex: 1; }
.actions { align-items: center; }
.inv-item { padding: 32rpx 0; border-bottom: 1rpx solid #F6E9DA; }
.inv-item:first-child { padding-top: 8rpx; }
.inv-item:last-child { border-bottom: 0; padding-bottom: 8rpx; }
.inv-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.inv-name { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; line-height: 1.45; word-break: break-word; }
.schip { flex-shrink: 0; margin-top: 4rpx; }
.inv-mid { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-top: 12rpx; }
.inv-meta { flex: 1; min-width: 0; font-size: 24rpx; color: #6B5A50; line-height: 1.55; word-break: break-word; }
.inv-amt { flex-shrink: 0; max-width: 240rpx; text-align: right; font-variant-numeric: tabular-nums; font-weight: 650; font-size: 30rpx; line-height: 1.45; color: #2B211C; }
.inv-extra { margin-top: 10rpx; font-size: 23rpx; color: #6B5A50; line-height: 1.55; word-break: break-word; }
.inv-actions { margin-top: 20rpx; display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.inv-actions .grow { min-width: 16rpx; }
