@import "../common.wxss";
.line { width: 100%; height: 400rpx; }
.readout .num { font-size: 32rpx; color: #B4532F; margin-left: 10rpx; }
.mx-hint { margin-top: 12rpx; }
.legend { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.lg { font-size: 22rpx; color: #4F4038; margin: 0 20rpx 8rpx 0; }
.tm { position: relative; width: 100%; height: 360rpx; margin-top: 16rpx; border-radius: 16rpx; overflow: hidden; background: #FBF3E4; }
.tm-empty { position: absolute; left: 0; right: 0; top: 45%; text-align: center; color: #6B5A50; font-size: 24rpx; }
.tm-cell { position: absolute; box-sizing: border-box; border: 2rpx solid #fff; color: #fff; padding: 10rpx; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
.tm-name { font-size: 21rpx; opacity: 0.95; }
.tm-v { font-size: 34rpx; font-weight: 700; line-height: 1.1; }
.tm-u { font-size: 20rpx; font-weight: 500; margin-left: 2rpx; }
.tm-p { font-size: 20rpx; opacity: 0.9; }
.tm-nums { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.tm-num { width: 50%; font-size: 22rpx; color: #2B211C; margin-top: 6rpx; }
.tm-num.zero { color: #6B5A50; }
.slider-wrap { margin-top: 20rpx; }
.ink { color: #2B211C; }
.coral-t { color: #B4532F; }
.mx { display: flex; margin-top: 20rpx; }
.mx-grid { flex: 1; display: flex; flex-wrap: wrap; }
.mx-cell { width: calc(50% - 12rpx); margin: 6rpx; box-sizing: border-box; min-height: 220rpx; background: #fff; border-radius: 22rpx; padding: 20rpx; border: 3rpx dashed #F0DCC8; }
.mx-cell.on { border-style: solid; }
.mx-name { font-size: 23rpx; font-weight: 600; }
.mx-count { font-size: 44rpx; font-weight: 700; margin-top: 8rpx; font-variant-numeric: tabular-nums; }
.mx-todo { color: #6B5A50; font-size: 26rpx; margin-top: 40rpx; }
