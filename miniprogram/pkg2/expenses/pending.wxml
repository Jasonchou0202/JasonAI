<view class="pg">
  <view class="eyebrow">报销记账</view>
  <view class="h1">待你确认</view>
  <view class="lead">成员提交的报销，确认后才计入十天合账。</view>
  <view class="loading" wx:if="{{loading}}">正在读取…</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="card" wx:if="{{!loading}}">
    <view class="empty" wx:if="{{!rows.length}}">没有待确认的报销。</view>
    <view class="list-item" wx:for="{{rows}}" wx:key="id">
      <view class="row"><text class="title-line">{{item.category}}</text><text class="num">{{item.amount}}</text></view>
      <view class="sub-line">{{item.date}} · {{item.payer}} · {{item.receipt}}</view>
      <view class="note" wx:if="{{item.note}}">{{item.note}}</view>
      <view class="actions">
        <view class="mini dark" data-id="{{item.id}}" data-kind="confirm" bindtap="act">确认入账</view>
        <view class="mini danger" data-id="{{item.id}}" data-kind="reject" bindtap="act">驳回</view>
        <view class="mini plain" wx:if="{{item.receiptCount}}" data-id="{{item.id}}" bindtap="receipts">看凭证</view>
      </view>
    </view>
  </view>
</view>
