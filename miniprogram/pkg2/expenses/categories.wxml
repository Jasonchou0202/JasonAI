<view class="pg">
  <view class="eyebrow">报销记账 · 管理员</view>
  <view class="h1">报销分类</view>
  <view class="lead">删除只是不在新记录里显示，已有报销会保留原来的分类。</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="card">
    <view class="add-row">
      <input class="input grow" placeholder="新分类名，如：差旅" maxlength="20" value="{{name}}" bindinput="onName" />
      <view class="mini dark" bindtap="add">添加</view>
    </view>
  </view>
  <view class="card">
    <view class="loading" wx:if="{{loading}}">正在读取…</view>
    <view class="list-item row" wx:for="{{rows}}" wx:key="id">
      <view><view class="title-line">{{item.name}}</view><view class="sub-line" wx:if="{{item.hint}}">{{item.hint}}</view></view>
      <view class="mini danger" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="archive">删除</view>
    </view>
  </view>
</view>
