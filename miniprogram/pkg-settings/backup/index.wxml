<privacy-popup />
<view class="page">
  <view class="hero">
    <view class="hero-title">备份与恢复</view>
    <view class="hero-sub">备份文件和网页下载的是同一种格式，网页和小程序可以互相恢复。</view>
  </view>

  <view class="panel">
    <view class="panel-title">保存完整备份</view>
    <view class="panel-desc">包含销售（含回收站）、商品、客户和日程。生成后发到聊天，建议发给「文件传输助手」再存到电脑。手机上不留副本。</view>
    <button class="primary" disabled="{{busy}}" bindtap="exportBackup">{{busy === 'export' ? '正在生成备份…' : '生成备份并发到聊天'}}</button>
    <view class="ok" wx:if="{{exported}}">{{exported}}</view>
  </view>

  <view class="panel">
    <view class="panel-title">从备份恢复</view>
    <view class="panel-desc">只能恢复到<text class="danger-text">空账本</text>：账本里已经有记录时会被拒绝，现有记录不会被覆盖。</view>
    <block wx:if="{{backup}}">
      <view class="stats">
        <view class="stat"><view class="stat-in"><view class="stat-label">销售记录</view><view class="stat-value">{{backup.sales}}</view></view></view>
        <view class="stat"><view class="stat-in"><view class="stat-label">商品</view><view class="stat-value">{{backup.products}}</view></view></view>
        <view class="stat"><view class="stat-in"><view class="stat-label">客户</view><view class="stat-value">{{backup.customers}}</view></view></view>
        <view class="stat"><view class="stat-in"><view class="stat-label">日程</view><view class="stat-value">{{backup.tasks}}</view></view></view>
      </view>
      <view class="note">备份时间：{{backup.exportedAt}}　文件：{{backup.fileName}}</view>
      <button class="primary" disabled="{{busy}}" bindtap="restore">{{busy === 'restore' ? status : '恢复到空账本'}}</button>
      <view class="progress" wx:if="{{busy === 'restore'}}"><view class="progress-bar" style="width: {{percent}}%"></view></view>
      <button class="ghost" disabled="{{busy}}" bindtap="clearPick">换一个文件</button>
    </block>
    <button class="ghost" wx:else disabled="{{busy}}" bindtap="pick">从聊天里选备份文件（.json）</button>
    <view class="ok" wx:if="{{restored}}">{{restored}}</view>
  </view>
  <view class="err" wx:if="{{error}}">{{error}}</view>
</view>
