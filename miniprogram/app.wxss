@import "styles/ui.wxss";
page { background: #FAF7F4; color: #2B2522; font-size: 30rpx; }
.wrap { padding: 48rpx 40rpx; }
.title { font-size: 44rpx; font-weight: 600; margin-bottom: 24rpx; }
.hint { color: #7A6A5F; font-size: 26rpx; line-height: 1.6; }
.card { background: #fff; border-radius: 24rpx; padding: 32rpx; margin-top: 32rpx; }
.field { margin-bottom: 28rpx; }
.label { font-size: 26rpx; color: #7A6A5F; margin-bottom: 12rpx; }
.input { border: 1rpx solid #E5DED8; border-radius: 16rpx; padding: 20rpx 24rpx; background: #fff; }
.btn { background: #D97757; color: #fff; border-radius: 16rpx; margin-top: 32rpx; }
.btn[disabled] { background: #E8C4B6 !important; color: #fff !important; }
.link { color: #B4532F; margin-top: 32rpx; text-align: center; }
.error { color: #9E2A1E; font-size: 26rpx; margin-top: 16rpx; }
.badge { display: inline-block; font-size: 22rpx; color: #7A6A5F; border: 1rpx solid #E5DED8; border-radius: 999rpx; padding: 4rpx 16rpx; }
