.mask { position: fixed; inset: 0; background: rgba(0,0,0,.4); display: flex; align-items: flex-end; z-index: 99; }
.sheet { background: #fff; width: 100%; padding: 40rpx; border-radius: 24rpx 24rpx 0 0; }
.title { font-size: 34rpx; font-weight: 600; margin-bottom: 16rpx; }
.hint { color: #7A6A5F; font-size: 26rpx; line-height: 1.6; }
.link-inline { color: #B4532F; }
.btn { background: #D97757; color: #fff; border-radius: 16rpx; margin-top: 32rpx; }
.link { color: #7A6A5F; margin-top: 24rpx; text-align: center; }
